<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    body { font-family: sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; }
    .form-group { display: flex; gap: 8px; margin-bottom: 20px; }
    input[type="text"] { flex: 1; padding: 8px; font-size: 16px; }
    button { padding: 8px 16px; font-size: 16px; cursor: pointer; }
    .error-message { color: red; margin-bottom: 16px; display: none; }
    ul { list-style: none; padding: 0; }
    li { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #eee; }
    .completed { text-decoration: line-through; color: #888; }
    .todo-item-left { display: flex; align-items: center; gap: 8px; }
    .delete-btn { background: #ff4d4f; color: white; border: none; border-radius: 4px; padding: 4px 8px; }
  </style>
</head>
<body>
  <h1>Todo 管理</h1>
  
  <div id="error-container" class="error-message"></div>

  <form id="todo-form" class="form-group">
    <input type="text" id="todo-title-input" placeholder="新しいタスクを入力..." maxlength="100">
    <button type="submit">追加</button>
  </form>

  <ul id="todo-list"></ul>

  <script src="/todo/app.js" defer></script>
</body>
</html>