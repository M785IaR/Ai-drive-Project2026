<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI質問アシスタント</title>
  <link rel="stylesheet" href="/ai/ai.css">
</head>
<body>
  <div class="container">
    <header class="header">
      <h1>AI質問アシスタント</h1>
      <nav>
        <a href="/" class="nav-link">TOPへ戻る</a>
      </nav>
    </header>

    <main>
      <!-- 質問入力セクション -->
      <section class="card">
        <h2>新しい質問をする</h2>
        <form id="ai-ask-form" novalidate>
          <div class="form-group">
            <label for="prompt-input">質問内容（1〜1,000文字）</label>
            <textarea
              id="prompt-input"
              name="prompt"
              rows="4"
              maxlength="1000"
              placeholder="AIに聞きたいことを入力してください..."
              required
            ></textarea>
            <div class="char-counter">
              <span id="char-count">0</span> / 1000 文字
            </div>
          </div>

          <!-- エラーメッセージ表示エリア -->
          <div id="error-message" class="alert alert-error hidden" role="alert"></div>

          <div class="form-actions">
            <button type="submit" id="submit-btn" class="btn btn-primary">
              質問を送信する
            </button>
          </div>
        </form>
      </section>

      <!-- 最新回答表示エリア -->
      <section id="latest-answer-section" class="card hidden">
        <h2>AIからの回答</h2>
        <div class="answer-box">
          <p class="question-preview"><strong>質問：</strong><span id="latest-prompt"></span></p>
          <hr>
          <div id="latest-response" class="response-text"></div>
        </div>
      </section>

      <!-- 過去の履歴一覧 -->
      <section class="card">
        <div class="history-header">
          <h2>最近の質問履歴（最新20件）</h2>
          <button type="button" id="reload-history-btn" class="btn btn-secondary btn-sm">更新</button>
        </div>
        <div id="history-loading" class="loading-text">履歴を読み込み中...</div>
        <div id="history-empty" class="empty-text hidden">履歴はまだありません。</div>
        <ul id="history-list" class="history-list"></ul>
      </section>
    </main>
  </div>

  <script src="/ai/ai.js" defer></script>
</body>
</html>